#!/usr/bin/env python3
"""One Job, as the agent's user.

`read-a-recipe` starts this through sudo, with job.json on stdin. It makes a
folder of the agent's own, fetches the Job's Original into it, points opencode
at Kamosu's MCP door with the Job Key, and starts opencode with the
instructions. What it prints on stdout is the Job's report.json, and it prints
one whatever happens: the report the agent left, or one saying the Job failed.

The agent's user runs one Job at a time, so anything of that user's still
running is either this Job or left over from the last one. A Job begins by
stopping what was left over and removing any folder an earlier Job left, and
ends, however it ends, by stopping everything it started, a process that left
its group included. The Runner cannot do that itself: the agent's processes
belong to another user.
"""

import glob
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import urllib.parse
import urllib.request

INSTRUCTIONS = "/opt/kamosu-runner/instructions.md"
PROMPT = (
    "Do the Job described in job.json in this folder, following your "
    "instructions. Leave report.json in this folder before you finish."
)
# What an Original arrives as, and the name the agent finds it under.
ORIGINAL_NAMES = {
    "text/plain": "original.txt",
    "application/pdf": "original.pdf",
    "image/jpeg": "original.jpg",
    "image/png": "original.png",
    "image/webp": "original.webp",
}

# stdout is the report and nothing else: whatever opencode or a tool prints
# goes to stderr, which the Runner shows in its own output.
report_out = os.fdopen(os.dup(1), "w")
os.dup2(2, 1)

root = None


def stop_everything(grace=2.0):
    """Stop every process of this user but this one."""
    try:
        os.kill(-1, signal.SIGTERM)
    except ProcessLookupError:
        return
    time.sleep(grace)
    try:
        os.kill(-1, signal.SIGKILL)
    except ProcessLookupError:
        pass


def clean_up(grace=2.0):
    """Stop what this Job started and remove its folder, the Job Key with it."""
    stop_everything(grace)
    if root:
        shutil.rmtree(root, ignore_errors=True)


def finish(report):
    clean_up()
    report_out.write(json.dumps(report))
    report_out.flush()
    sys.exit(0)


def failed(reason):
    finish({"outcome": "failed", "reason": reason})


def stopped(signum, _frame):
    clean_up(grace=0.5)
    sys.exit(128 + signum)


for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
    signal.signal(signum, stopped)

# What an earlier Job left: processes, and a folder a stopped container never
# got to remove.
stop_everything(grace=0)
for left in glob.glob(os.path.join(tempfile.gettempdir(), "kamosu-agent-*")):
    shutil.rmtree(left, ignore_errors=True)

model = os.environ.get("KAMOSU_AGENT_MODEL", "").strip()
if not model:
    failed("The Runner's container was started with no model for the agent.")
provider, _, model_id = model.partition("/")
effort = os.environ.get("KAMOSU_AGENT_EFFORT", "").strip()
if effort:
    model += "#" + effort

try:
    handed = json.load(sys.stdin)
    kamosu = handed["kamosu"]
    mcp = handed["mcp"]
    job = handed["job"]
    job_key = job["job_key"]
except (ValueError, KeyError, TypeError) as e:
    failed(f"The Runner handed over a Job the agent could not read: {e}.")

root = tempfile.mkdtemp(prefix="kamosu-agent-")
work = os.path.join(root, "job")
os.mkdir(work)
with open(os.path.join(work, "job.json"), "w") as f:
    json.dump(handed, f, indent=2)

original = job.get("original")
if original:
    request = urllib.request.Request(
        urllib.parse.urljoin(kamosu, original["address"]),
        headers={"Authorization": "Bearer " + job_key},
    )
    try:
        with urllib.request.urlopen(request, timeout=120) as answer:
            kind = answer.headers.get_content_type()
            body = answer.read()
    except OSError as e:
        failed(f"The agent could not fetch what it was handed to read: {e}.")
    name = ORIGINAL_NAMES.get(kind, "original")
    with open(os.path.join(work, name), "wb") as f:
        f.write(body)

# opencode's settings, sessions and caches live in this Job's folder and go
# with it, so nothing one Job does is there for the next. Kamosu's MCP door
# speaks revision 2026-07-28 alone, which opencode speaks when told to. Every
# tool is allowed but the one that asks a question nobody will answer.
config = {
    "$schema": "https://opencode.ai/config.json",
    "update": "disable",
    "snapshots": False,
    "permissions": [
        {"action": "*", "resource": "*", "effect": "allow"},
        {"action": "question", "resource": "*", "effect": "deny"},
    ],
    "mcp": {
        "servers": {
            "kamosu": {
                "type": "remote",
                "url": mcp,
                "protocol": "2026-07-28",
                "oauth": False,
                "codemode": False,
                "headers": {"Authorization": "Bearer {env:KAMOSU_JOB_KEY}"},
            }
        }
    },
}
# The key for the model's provider, whichever it is (#318). The settings hold
# the variable's name and opencode reads its value, so the key is in no file.
# Without it, opencode reads the provider's own variable. With a base URL,
# the provider is one opencode does not know, declared here with the one
# model, which is told it takes pictures: a photo of a page reaches it as one.
# No PDF, which an OpenAI-compatible service may refuse: the agent finds it
# cannot open one and turns its pages into pictures, as instructions.md says.
settings = {}
if os.environ.get("KAMOSU_AGENT_API_KEY", "").strip():
    settings["apiKey"] = "{env:KAMOSU_AGENT_API_KEY}"
base_url = os.environ.get("KAMOSU_AGENT_BASE_URL", "").strip()
if base_url:
    if not model_id:
        failed("KAMOSU_AGENT_MODEL names no model after its provider, as provider/model.")
    settings["baseURL"] = base_url
    config["providers"] = {
        provider: {
            "package": "@ai-sdk/openai-compatible",
            "settings": settings,
            "models": {
                model_id: {
                    "capabilities": {
                        "tools": True,
                        "input": ["text", "image"],
                        "output": ["text"],
                    }
                }
            },
        }
    }
elif settings:
    config["providers"] = {provider: {"settings": settings}}
config_dir = os.path.join(root, "config", "opencode")
os.makedirs(config_dir)
with open(os.path.join(config_dir, "opencode.json"), "w") as f:
    json.dump(config, f, indent=2)
# The instructions, as opencode's own for every project.
shutil.copy(INSTRUCTIONS, os.path.join(config_dir, "AGENTS.md"))

env = dict(os.environ)
env.update(
    {
        # sudo passes on the Runner's PWD, its own Job folder, and an agent
        # may take its project from PWD over the folder it was started in.
        "PWD": work,
        "HOME": "/home/agent",
        "USER": "agent",
        "LOGNAME": "agent",
        "XDG_CONFIG_HOME": os.path.join(root, "config"),
        "XDG_DATA_HOME": os.path.join(root, "data"),
        "XDG_STATE_HOME": os.path.join(root, "state"),
        "XDG_CACHE_HOME": os.path.join(root, "cache"),
        "TMPDIR": os.path.join(root, "tmp"),
        "KAMOSU_ADDRESS": kamosu,
        "KAMOSU_JOB_KEY": job_key,
    }
)
os.mkdir(env["TMPDIR"])

# --standalone keeps opencode's server inside this Job instead of a
# background service that would outlive it.
command = ["opencode", "run", "--standalone", "--auto", "--model", model, PROMPT]

ran = subprocess.run(command, cwd=work, env=env, stdin=subprocess.DEVNULL)

# The contract asks for status 0 with a report, so a report left by an agent
# that then crashed does not stand.
if ran.returncode != 0:
    failed(f"The agent stopped with an error (status {ran.returncode}).")
report_file = os.path.join(work, "report.json")
if not os.path.isfile(report_file):
    failed("The agent finished without leaving a report.")
try:
    with open(report_file) as f:
        report = json.load(f)
except ValueError:
    failed("The agent left a report that is not JSON.")
finish(report)
