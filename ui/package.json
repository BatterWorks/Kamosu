{
  "name": "kamosu-ui",
  "private": true,
  "version": "0.5.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && paraglide-js compile --project ./project.inlang --output-structure locale-modules --silent && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p ./src/service-worker",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "css": "tailwindcss -i ./src/app.css -o \"${CSS_OUT:-../assets/app.css}\"",
    "icons": "node ./generate-icons.mjs",
    "client": "node ./generate-client.mjs",
    "manifest": "node ./generate-manifest.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^3.1.0",
    "@inlang/plugin-m-function-matcher": "^2.4.3",
    "@inlang/plugin-message-format": "^4.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/cli": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "description": "Kamosu's interface: one Svelte app, one generated stylesheet, one typed client.",
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
