{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		"types": ["$app/types", "node"]
	},
	"include": ["src", "vite.config.ts"],
	// The service worker is a project of its own, with a worker's globals
	// rather than a page's: src/service-worker/tsconfig.json (#525).
	"exclude": ["src/service-worker"]
}
